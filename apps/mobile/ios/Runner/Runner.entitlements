<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- iOS Universal Links for email confirmation and recovery (spec 03).
	     APP_LINK_HOST is a build setting (set per environment); the domain is
	     verified with https://<host>/.well-known/apple-app-site-association.
	     Requires the Associated Domains capability in the provisioning profile. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:$(APP_LINK_HOST)</string>
	</array>
</dict>
</plist>
