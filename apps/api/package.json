{
  "name": "@chicman/api",
  "version": "0.1.0",
  "private": true,
  "description": "Chicman marketplace REST API (Node.js + Express + TypeScript)",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "prisma generate && tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "typecheck": "prisma generate && tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "prisma generate && tsx --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "worker": "prisma generate && tsx src/workers/index.ts",
    "worker:start": "node dist/workers/index.js"
  },
  "dependencies": {
    "@chicman/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "5.11.1",
    "jose": "6.2.15",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
