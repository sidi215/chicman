NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# PostgreSQL (infrastructure/docker). Adjust the port to POSTGRES_PORT.
DATABASE_URL=postgresql://chicman:chicman@localhost:5432/chicman
# Separate database for the API tests (authorization tests are skipped without it).
# Prepare it with: DATABASE_URL=<this url> pnpm --filter @chicman/api db:deploy
TEST_DATABASE_URL=postgresql://chicman:chicman@localhost:5432/chicman_test

# Supabase Auth (required — the API refuses to start without these).
# The project must use asymmetric JWT signing keys (ES256/RS256).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Publishable key, used only to read the user's own Auth record (email-confirmation
# check at account setup). Never the secret key: the API does not need one.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>
# Timeout for that call (optional; default shown).
SUPABASE_AUTH_TIMEOUT_MS=3000

# Redis for rate-limit counters (required in production; without it, development
# uses in-memory counters). Use the REDIS_PORT of infrastructure/docker.
REDIS_URL=redis://localhost:6379
# Number of trusted reverse-proxy hops in front of the API (for client IPs).
TRUST_PROXY_HOPS=0

# JWKS retrieval hardening (optional; defaults shown).
SUPABASE_JWKS_TIMEOUT_MS=3000
SUPABASE_JWKS_COOLDOWN_MS=30000
SUPABASE_JWKS_MAX_AGE_MS=600000
