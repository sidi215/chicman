NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# PostgreSQL (infrastructure/docker). Adjust the port to POSTGRES_PORT.
DATABASE_URL=postgresql://chicman:chicman@localhost:5432/chicman
# Separate database for the API tests (authorization tests are skipped without it).
# Prepare it with: DATABASE_URL=<this url> pnpm --filter @chicman/api db:deploy
TEST_DATABASE_URL=postgresql://chicman:chicman@localhost:5432/chicman_test

# Supabase Auth (required — the API refuses to start without these).
# The project must use asymmetric JWT signing keys (ES256/RS256).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Publishable key, used only to read the user's own Auth record (email-confirmation
# check at account setup). Never the secret key: the API does not need one.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>
# Timeout for that call (optional; default shown).
SUPABASE_AUTH_TIMEOUT_MS=3000

# Redis for rate-limit counters (required in production; without it, development
# uses in-memory counters). Use the REDIS_PORT of infrastructure/docker.
REDIS_URL=redis://localhost:6379
# Number of trusted reverse-proxy hops in front of the API (for client IPs).
TRUST_PROXY_HOPS=0
# Shared with the web server (same variable in apps/web), which renders public
# pages and passes the customer's address, so rate limits stay per customer.
# Needed wherever customers reach the site; without it, all server-rendered
# pages share the web server's limit. Generate: openssl rand -hex 32
CATALOG_INTERNAL_KEY=

# JWKS retrieval hardening (optional; defaults shown).
SUPABASE_JWKS_TIMEOUT_MS=3000
SUPABASE_JWKS_COOLDOWN_MS=30000
SUPABASE_JWKS_MAX_AGE_MS=600000

# S3-compatible object storage for shop logos (spec 06): SeaweedFS locally
# (infrastructure/docker, service object-storage), Cloudflare R2 in production.
# All or none outside production (without them, logo uploads return 503).
# Prepare the buckets once with: pnpm --filter @chicman/api storage:setup -- --public-acl
S3_ENDPOINT=http://localhost:8333
S3_REGION=auto
S3_ACCESS_KEY_ID=chicman
S3_SECRET_ACCESS_KEY=chicman-dev-secret
# Private staging bucket (presigned uploads) and public media bucket (verified logos).
S3_UPLOADS_BUCKET=chicman-uploads
S3_MEDIA_BUCKET=chicman-media
# Public origin of the media bucket (R2: its custom domain or r2.dev URL).
MEDIA_PUBLIC_BASE_URL=http://localhost:8333/chicman-media
# Logo completion lease and window (optional; defaults shown).
LOGO_COMPLETION_LEASE_MS=60000
LOGO_COMPLETION_WINDOW_MS=900000

# Order chain (specs 10 and 11). Optional; defaults shown.
# Hours a seller has to confirm or reject a new shop order (D7).
ORDER_RESPONSE_TIMEOUT_HOURS=48
# Checkout placements per user and per IP address per window (S2-6).
CHECKOUT_RATE_LIMIT_PER_USER=20
CHECKOUT_RATE_LIMIT_PER_IP=60
CHECKOUT_RATE_LIMIT_WINDOW_MS=600000

# S3 integration tests (optional; skipped without TEST_S3_ENDPOINT). They create
# and delete their own buckets.
# TEST_S3_ENDPOINT=http://localhost:8333
# TEST_S3_ACCESS_KEY_ID=chicman
# TEST_S3_SECRET_ACCESS_KEY=chicman-dev-secret

# Cloudflare R2 verification (optional; test/shop-logo-r2.test.ts, skipped without
# them). Use existing buckets (the test never creates buckets or sets ACLs); it
# writes only under test-shop prefixes and deletes everything afterwards.
# R2_TEST_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_TEST_ACCESS_KEY_ID=
# R2_TEST_SECRET_ACCESS_KEY=
# R2_TEST_UPLOADS_BUCKET=
# R2_TEST_MEDIA_BUCKET=
# R2_TEST_MEDIA_PUBLIC_BASE_URL=https://pub-<id>.r2.dev
# R2_TEST_CORS_ORIGIN=http://localhost:3000
