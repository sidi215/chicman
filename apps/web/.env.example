# Public configuration (inlined into the browser bundle at build time).
# Supabase project URL and publishable (anon) key — never the secret/service key.
NEXT_PUBLIC_SUPABASE_URL=https://hamdzxesiorzmxgymeyb.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_aDAlAcWvn3j_V4HuuPhqtg_Fm4czi6P
# Chicman API base URL (without /api/v1)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Site URL of this environment (no trailing slash). The email callback is
# <NEXT_PUBLIC_SITE_URL>/auth/callback and must be on the Supabase redirect allowlist.
# Search engines: robots.txt blocks everything and the sitemap stays empty until
# this is a public HTTPS domain, read at build time for robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cloudflare Turnstile public site key (empty: Turnstile disabled). Local and
# tests may use Cloudflare's test key 1x00000000000000000000AA (always passes).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Shop logos (spec 06): origin of the object-storage endpoint that receives
# presigned uploads (SeaweedFS locally, R2 in production), and the public media
# base URL (the API's MEDIA_PUBLIC_BASE_URL). Both are added to the CSP.
NEXT_PUBLIC_STORAGE_UPLOAD_ORIGIN=http://localhost:8333
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:8333/chicman-media
# Server only (never NEXT_PUBLIC_). Public pages are rendered from the API.
# API address as seen from this server, when it differs from NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=
# Same value as the API's CATALOG_INTERNAL_KEY. Passes the customer's address,
# so rate limits stay per customer rather than shared by this server.
CATALOG_INTERNAL_KEY=
# Number of proxies in front of this server (default 1). Their addresses are
# skipped when reading the customer's address from X-Forwarded-For.
TRUST_PROXY_HOPS=1
