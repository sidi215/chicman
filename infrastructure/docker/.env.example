# Copy to .env in this directory and adjust. Never commit the real .env.

POSTGRES_USER=chicman
POSTGRES_PASSWORD=chicman
POSTGRES_DB=chicman
POSTGRES_PORT=5432

REDIS_PORT=6379

MEILI_MASTER_KEY=chicman-dev-master-key-change-me
MEILI_PORT=7700

S3_ACCESS_KEY_ID=chicman
S3_SECRET_ACCESS_KEY=chicman-dev-secret
S3_PORT=8333

# Address the published ports listen on (default: this machine only).
# 0.0.0.0 exposes PostgreSQL, Redis (no password), Meilisearch, and object
# storage to the whole network; use it only on a trusted network.
DEV_BIND_ADDRESS=127.0.0.1
