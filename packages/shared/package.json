{
  "name": "@chicman/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared TypeScript definitions for the Chicman web and API applications",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
